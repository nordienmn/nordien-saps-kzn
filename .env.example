# Copy to .env for local use. .env is git-ignored. Never commit real values.
DESK_PASSWORD=choose-a-demo-password
BOARD_PASSWORD=choose-another-demo-password
ADMIN_TOKEN=choose-a-long-random-string
SECRET_KEY=any-long-random-string

# memory (default) or firestore
STORE=memory
GCP_PROJECT=nordien-saps-kzn

# Optional: real video calls (Twilio Video). Create an API key in the Twilio console.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# Optional: WhatsApp (Twilio). Sandbox sender looks like whatsapp:+14155238886
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
WHATSAPP_DISPLAY=
WHATSAPP_JOIN_HINT=
PUBLIC_URL=
